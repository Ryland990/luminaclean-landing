{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tryme",
      "destination": "/try.html",
      "permanent": false
    },
    {
      "source": "/blog/ai-photo-management-machine-learning.html",
      "destination": "/blog/why-iphone-storage-full-after-deleting-photos.html",
      "permanent": true
    },
    {
      "source": "/blog/organize-photos-iphone-guide.html",
      "destination": "/blog/iphone-storage-full-free-space.html",
      "permanent": true
    },
    {
      "source": "/blog/icloud-photos-storage-sync.html",
      "destination": "/blog/cleaner-app-deleted-photos-from-icloud.html",
      "permanent": true
    },
    {
      "source": "/blog/photo-cleaner-weekly-subscription-cost.html",
      "destination": "/blog/best-photo-cleaner-no-subscription-iphone.html",
      "permanent": true
    },
    {
      "source": "/blog/space-saved-cleaning-photos.html",
      "destination": "/blog/iphone-storage-full-free-space.html",
      "permanent": true
    },
    {
      "source": "/blog/delete-similar-photos-iphone.html",
      "destination": "/blog/delete-duplicate-photos-iphone.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/go",
      "destination": "/api/go"
    }
  ]
}
